                </svg>
                <span>Centro de Recargas</span>
            </a>
            <div style="display: flex; gap: 20px;">
                <select style="padding: 8px 12px; border-radius: 6px; border: 1px solid #ddd; background: white;">
                    <option>🇨🇴 Colombia</option>
                    <option>🇵🇪 Perú</option>
                    <option>🇧🇷 Brasil</option>
                </select>
                <select style="padding: 8px 12px; border-radius: 6px; border: 1px solid #ddd; background: white;">
                    <option>Español</option>
                    <option>Português</option>
                    <option>English</option>
                </select>
            </div>
        </div>
    </header>
    
    <!-- Banner -->
    <div class="banner">
        <img src="https://contentgarena-a.akamaihd.net/GOP/newshop_banners/17-12-25-900x340FFSAC.jpg?v=1768500475" alt="Banner Free Fire">
    </div>
    
    <!-- Game Selection Nav -->
    <div class="nav">
        <div style="max-width: 1200px; margin: 0 auto;">
            <h3>Selección de Juego</h3>
            <div class="game-selector">
                <div class="game-item">
                    <div class="game-icon">
                        <img src="https://cdn-gop.garenanow.com/gop/app/0000/100/067/icon.png" alt="Free Fire">
                    </div>
                    <div class="game-name">Free Fire</div>
                </div>
                <div class="game-item">
                    <div class="game-icon">
                        <img src="https://cdn-gop.garenanow.com/gop/app/0000/100/151/icon.png" alt="Delta Force">
                    </div>
                    <div class="game-name">Delta Force</div>
                </div>
                <div class="game-item">
                    <div class="game-icon">
                        <img src="https://cdn-gop.garenanow.com/gop/app/0000/100/153/icon.png" alt="HAIKYU">
                    </div>
                    <div class="game-name">HAIKYU!! FLY HIGH</div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Main Content -->
    <main class="main">
        <!-- App Banner -->
        <div class="app-banner">
            <div class="app-icon">
                <img src="https://cdn-gop.garenanow.com/gop/app/0000/100/067/icon.png" alt="Free Fire">
            </div>
            <div class="app-info">
                <h1>Free Fire</h1>
                <div class="security-badge">
                    ✓ Pago 100% seguro
                </div>
            </div>
        </div>
        
        <!-- Section 1: Login -->
        <div class="section">
            <div class="section-title">
                <div class="section-number">1</div>
                Ingresar
            </div>
            <div class="form-group">
                <label class="form-label">ID de jugador</label>
                <div style="display: flex; gap: 10px;">
                    <input type="text" class="form-input" placeholder="Introduce el ID del jugador aquí." style="flex: 1;">
                    <button class="button">Iniciar Sesión</button>
                </div>
            </div>
        </div>
        
        <!-- Section 2: Denomination Selection -->
        <div class="section">
            <div class="section-title">
                <div class="section-number">2</div>
                Monto de recarga
            </div>
            <div class="denomination-grid">
                <button class="denomination-btn">100 💎</button>
                <button class="denomination-btn">310 💎</button>
                <button class="denomination-btn">520 💎</button>
                <button class="denomination-btn">1.050 💎</button>
                <button class="denomination-btn">1.060 💎</button>
                <button class="denomination-btn">2.160 💎</button>
                <button class="denomination-btn">2.180 💎</button>
                <button class="denomination-btn">5.580 💎</button>
                <button class="denomination-btn">5.600 💎</button>
            </div>
            
            <!-- Special Offers -->
            <h4 style="margin: 30px 0 15px 0; color: #999;">Ofertas especiales</h4>
            <div class="special-offers">
                <div class="offer-card">
                    <div class="offer-image">
                        <img src="https://cdn-gop.garenanow.com/gop/app/0000/100/067/rebate/0000/000/002/logo.png" alt="Tarjeta Semanal">
                    </div>
                    <div class="offer-name">Tarjeta Semanal</div>
                </div>
                <div class="offer-card">
                    <div class="offer-image">
