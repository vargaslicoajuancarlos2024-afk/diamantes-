<!DOCTYPE html>
<html lang="es" class="dark" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0">
    <title>Centro de Recarga Garena</title>
    <meta name="description" content="La página oficial para recargar diamantes en Free Fire. Varios métodos de pago están disponibles para jugadores de América Latina.">
    <meta name="keywords" content="carga, garena, juego, juegos">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #151515;
            color: #ffffff;
            line-height: 1.6;
        }
        
        header {
            background: #ffffff;
            border-bottom: 1px solid #e0e0e0;
            padding: 12px 20px;
            position: sticky;
            top: 0;
            z-index: 10;
        }
        
        .header-content {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        
        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: #333;
            font-weight: bold;
        }
        
        .logo img {
            width: 40px;
            height: auto;
        }
        
        .banner {
            background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
            padding: 40px 20px;
            text-align: center;
        }
        
        .banner img {
            max-width: 100%;
            height: auto;
            border-radius: 12px;
            max-height: 400px;
        }
        
        .nav {
            background: linear-gradient(180deg, #16162B 0%, #242443 76.1%, #333356 100%);
            padding: 30px 20px;
        }
        
        .nav h3 {
            color: #ffffff;
            margin-bottom: 20px;
            font-size: 18px;
        }
        
        .game-selector {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
            gap: 20px;
            max-width: 1200px;
            margin: 0 auto;
        }
        
        .game-item {
            text-align: center;
            cursor: pointer;
            transition: transform 0.2s;
        }
        
        .game-item:hover {
            transform: scale(1.05);
        }
        
        .game-icon {
            width: 80px;
            height: 80px;
            margin: 0 auto 10px;
            border-radius: 20%;
            border: 3px solid #E41E26;
            overflow: hidden;
            background: #fff;
        }
        
        .game-icon img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .game-name {
            font-size: 14px;
            color: #999;
        }
        
        .main {
            max-width: 1200px;
            margin: 0 auto;
            padding: 40px 20px;
        }
        
        .app-banner {
            background: linear-gradient(135deg, #BDBDC5 0%, #999 100%);
            padding: 30px;
            border-radius: 12px;
            margin-bottom: 40px;
            display: flex;
            align-items: center;
            gap: 20px;
        }
        
        .app-icon {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            overflow: hidden;
        }
        
        .app-icon img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .app-info h1 {
            font-size: 28px;
            margin-bottom: 10px;
        }
        
        .security-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(0, 0, 0, 0.65);
            color: #ffffff;
            padding: 8px 12px;
            border-radius: 6px;
            border: 1px solid rgba(255, 255, 255, 0.5);
            font-size: 12px;
        }
        
        .section {
            margin-bottom: 40px;
        }
        
        .section-title {
            font-size: 20px;
            font-weight: bold;
            margin-bottom: 20px;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .section-number {
            background: #E41E26;
            color: #ffffff;
            width: 32px;
            height: 32px;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }
        
        .form-group {
            margin-bottom: 20px;
        }
        
        .form-label {
            display: block;
            margin-bottom: 10px;
            font-weight: 500;
            font-size: 14px;
        }
        
        .form-input {
            width: 100%;
            padding: 12px;
            border: 1px solid #444;
            border-radius: 6px;
            background: #2a2a2a;
            color: #ffffff;
            font-size: 14px;
        }
        
        .form-input:focus {
            outline: none;
            border-color: #E41E26;
        }
        
        .button {
            background: #E41E26;
            color: #ffffff;
            padding: 12px 24px;
            border: none;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            font-size: 14px;
            transition: background 0.3s;
        }
        
        .button:hover {
            background: #c91820;
        }
        
        .denomination-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
            gap: 12px;
            margin-bottom: 20px;
        }
        
        .denomination-btn {
            padding: 15px;
            border: 2px solid #444;
            border-radius: 8px;
            background: #2a2a2a;
            color: #ffffff;
            cursor: pointer;
            font-weight: 600;
            text-align: center;
            transition: all 0.2s;
        }
        
        .denomination-btn:hover {
            border-color: #E41E26;
        }
        
        .denomination-btn.active {
            background: #E41E26;
            border-color: #E41E26;
        }
        
        .payment-methods {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
            gap: 15px;
        }
        
        .payment-method {
            padding: 20px;
            border: 2px solid #444;
            border-radius: 8px;
            background: #2a2a2a;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s;
        }
        
        .payment-method:hover {
            border-color: #E41E26;
        }
        
        .payment-method img {
            width: 60px;
            height: 60px;
            margin: 0 auto 10px;
            object-fit: contain;
        }
        
        .payment-method-name {
            font-size: 13px;
            font-weight: 600;
        }
        
        .promo-badge {
            display: inline-block;
            background: #E41E26;
            color: #ffffff;
            padding: 3px 8px;
            border-radius: 3px;
            font-size: 11px;
            font-weight: bold;
            margin-top: 8px;
        }
        
        .special-offers {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
        }
        
        .offer-card {
            border-radius: 8px;
            overflow: hidden;
            cursor: pointer;
            transition: transform 0.2s;
        }
        
        .offer-card:hover {
            transform: translateY(-5px);
        }
        
        .offer-image {
            width: 100%;
            padding-top: 56.25%;
            background: #444;
            position: relative;
            overflow: hidden;
        }
        
        .offer-image img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .offer-name {
            padding: 12px;
            background: #2a2a2a;
            font-size: 14px;
            font-weight: 600;
        }
        
        footer {
            background: #1a1a1a;
            border-top: 1px solid #444;
            padding: 30px 20px;
            text-align: center;
            color: #999;
            font-size: 12px;
        }
        
        .footer-links {
            margin-top: 15px;
        }
        
        .footer-links a {
            color: #999;
            text-decoration: none;
            margin: 0 15px;
            transition: color 0.2s;
        }
        
        .footer-links a:hover {
            color: #E41E26;
        }
        
        @media (max-width: 768px) {
            .app-banner {
                flex-direction: column;
                text-align: center;
            }
            
            .denomination-grid {
                grid-template-columns: repeat(3, 1fr);
            }
            
            .payment-methods {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header>
        <div class="header-content">
            <a href="#" class="logo">
                <svg width="40" height="40" viewBox="0 0 34 36" fill="none" xmlns="http://www.w3.org/2000/svg">
